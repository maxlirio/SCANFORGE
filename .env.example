# Copy to .env and adjust. Every value here has a working default.

# --- server ---------------------------------------------------------------
PORT=5174
HOST=0.0.0.0
# Where jobs, uploads and finished models are written.
SCANFORGE_DATA_DIR=./data
# Reconstruction is CPU-bound; more than 1 at a time just makes each slower.
SCANFORGE_CONCURRENCY=1
SCANFORGE_MAX_IMAGES=250
SCANFORGE_MAX_UPLOAD_BYTES=33554432

# --- reconstruction -------------------------------------------------------
# colmap-local (default, no key needed) or replicate (hosted GPU, needs a token)
SCANFORGE_PROVIDER=colmap-local
# Defaults to pipeline/.venv/bin/python when that exists.
# SCANFORGE_PYTHON=/usr/local/bin/python3
# Only needed if colmap is not on PATH.
# COLMAP_BIN=/opt/homebrew/bin/colmap
# Optional AGPL dense tier - see docs/OPENMVS.md. Auto-detected if present.
# OPENMVS_BIN_DIR=$HOME/.scanforge/openmvs/bin

# --- optional hosted GPU provider ----------------------------------------
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_MODEL=firtoz/trellis
# REPLICATE_MODEL_VERSION=
# REPLICATE_IMAGES_FIELD=images
